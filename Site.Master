<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="PitStop.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="utf-8" />
    <title>
    <asp:ContentPlaceHolder ID="TitleContent" runat="server">PitStop</asp:ContentPlaceHolder></title>
    <link href="~/Content/site.css" rel="stylesheet" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
       <header class="site-header">
    <div class="site-logo">
        <img src="~/Images/flow.logo.svg" alt="PitStop" runat="server" class="logo-img" /> Pit<span class="logo-accent">Stop</span>
    </div>
    <nav class="site-nav">
        <ul class="nav-list">
            <li class="nav-item"><a href="~/Default.aspx" runat="server">About</a></li>
            <li class="nav-item"><a href="~/Default.aspx#features" runat="server">Features</a></li>
            <li class="nav-item"><a href="~/Default.aspx#how-it-works" runat="server">How It Works</a></li>
        </ul>
    </nav>
    <div class="header-actions">
        <a href="~/Login.aspx" runat="server" class="btn-outline-sm">Login</a>
        <a href="~/Register.aspx" runat="server" class="btn-fill-sm">Register</a>
    </div>
</header>

        <main class="site-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <footer class="site-footer">
    <div class="footer-main">
        <div class="footer-brand">
            <div class="footer-logo">
                <img src="~/Images/flow.logo.svg" alt="PitStop" runat="server" class="logo-img" /> Pit<span class="logo-accent">Stop</span>
                
            </div>
            <p class="footer-desc">Gamified F1 learning platform for F1 in Schools teams. Built by APU students, for SMK Bandar Putra, Johor.</p>
        </div>

        <div class="footer-col">
            <h4 class="footer-heading">Navigation</h4>
            <ul class="footer-links">
                <li class="nav-item"><a href="~/Default.aspx" runat="server">About</a></li>
                <li><a href="~/Default.aspx#features" runat="server">Features</a></li>
                <li><a href="~/Default.aspx#how-it-works" runat="server">How It Works</a></li>
                <li><a href="~/Default.aspx#team" runat="server">Our Team</a></li>
            </ul>
        </div>

        <div class="footer-col">
            <h4 class="footer-heading">Access</h4>
            <ul class="footer-links">
                <li><a href="~/Login.aspx" runat="server">Student Login</a></li>
                <li><a href="~/Login.aspx" runat="server">Advisor Dashboard</a></li>
                <li><a href="~/Register.aspx" runat="server">Register</a></li>
                <li><a href="~/Terms.aspx" runat="server">Terms of Use</a></li>
            </ul>
        </div>
    </div>

    <div class="footer-bottom">
        <span>&copy; 2026 PitStop &middot; CT050-3-2-WAPP &middot; APU</span>
        <span>Built for F1 in Schools &middot; SMK Bandar Putra, Johor</span>
    </div>
</footer>
    </form>
</body>
</html>
